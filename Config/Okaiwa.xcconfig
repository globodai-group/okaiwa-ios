//
//  Okaiwa.xcconfig
//  Build configuration — versioning and signing.
//
//  Mirrors the Android scheme exactly:
//    MARKETING_VERSION       ↔ versionName  = {MAJOR}.{MINOR}.{count}
//    CURRENT_PROJECT_VERSION ↔ versionCode  = git commit count
//
//  Both values are overwritten by scripts/set-ios-build-number.sh at
//  build time, which runs `git rev-list --count HEAD` to keep Android
//  and iOS uploads in lock-step. The literals below are only used when
//  building from a source tarball without the build phase wired up.
//
//  Bump the MAJOR/MINOR segments here AND in
//  okaiwa-android/app/build.gradle.kts (okaiwaMajor / okaiwaMinor) when
//  a user-facing milestone ships.
//

// Placeholder — set-ios-build-number.sh rewrites this to 1.0.{count}.
MARKETING_VERSION = 1.0.1

// Placeholder — set-ios-build-number.sh rewrites this to {count}.
CURRENT_PROJECT_VERSION = 1

// Bundle identifier matches the Firebase iOS app created via CLI.
PRODUCT_BUNDLE_IDENTIFIER = io.okaiwa.ios

// Minimum iOS version — Secure Enclave + CryptoKit require iOS 17+.
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// Apple Team ID is injected via environment variable during archive:
//   DEVELOPMENT_TEAM = $(OKAIWA_APPLE_TEAM_ID)
// The team ID is never committed to the repo — it lives in CI secrets
// and on each developer's local .xcconfig.private file.
DEVELOPMENT_TEAM = $(OKAIWA_APPLE_TEAM_ID)

// Automatic code signing — Xcode fetches the development profile.
CODE_SIGN_STYLE = Automatic

// Swift language version pinned to match the Package.swift toolchain.
SWIFT_VERSION = 5.9

// Build settings shared across Debug and Release.
SWIFT_STRICT_CONCURRENCY = complete
CLANG_WARN_STRICT_PROTOTYPES = YES
GCC_TREAT_WARNINGS_AS_ERRORS = NO
